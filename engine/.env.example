APP_NAME=KioTrad
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
SIMULATION_CAPITAL_NAIRA=7000
SIMULATION_CACHE_ENABLED=true
DASHBOARD_ASYNC=true
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=15000
REDIS_HOST=redis
REDIS_LOCK_HOST=redis-locks
REDIS_CACHE_MAXMEMORY=512mb
REDIS_PORT=6379
LOG_CHANNEL=stderr
DB_CONNECTION=mongodb
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=kiotrad
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
PROVIDER_ARCHIVE_RAW_RESPONSES=true
PROVIDER_HISTORY_SEASONS=81
SLACK_NOTIFICATIONS_ENABLED=false
SLACK_WEBHOOK_URL=
WEB_PORT=5173
API_PORT=8000
MONGO_PORT=27018

# Qualification delivery requires APP_ENV=production on the production server; local mirrors are blocked.
# Optional qualification email worker (reference total run capital: NGN 50,000).
QUALIFICATION_EMAIL_ENABLED=false
QUALIFICATION_EMAIL_TO=
QUALIFICATION_EMAIL_CAPITAL_MINOR=5000000
QUALIFICATION_EMAIL_LEAD_SECONDS=10
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
QUALIFICATION_EMAIL_SETTINGS_TOKEN=

# Uses SLACK_WEBHOOK_URL; replaces legacy qualification/quote prompts when enabled.
QUALIFICATION_SLACK_ENABLED=false
QUALIFICATION_SLACK_SETTINGS_TOKEN=

# Optional unified Alerts key; falls back to existing email, then Slack settings key.
QUALIFICATION_ALERT_SETTINGS_TOKEN=
